# Local development — copy to .env and restart `npm run dev`
# cp .env.example .env
#
# Deploy: set these at build time (Vite embeds VITE_* vars).

# skyprep-classroom-backend (auth, admin API, test bank proxy at /bank/*)
# Must include /api/v1 — see src/lib/http/api-client.js
VITE_API_BASE_URL=http://localhost:4000/api/v1

VITE_APP_NAME=SkyPrep Admin

# Classroom public URL — wrong-app hint for student invites
VITE_CLASSROOM_APP_URL=http://localhost:5173
